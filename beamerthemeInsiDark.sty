\ProvidesPackage{beamerthemeInsiDark}[2026/05/07 v1.0 Minimal NU dark Beamer theme]

\RequirePackage[T1]{fontenc}
\RequirePackage[sfdefault, light]{FiraSans}
\RequirePackage[lining]{FiraMono}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\usepgfplotslibrary{colorbrewer}
\RequirePackage{graphicx}
\RequirePackage{currfile}
% Capture the package's own directory at load time so assets/ is found
% regardless of where the document is compiled from.
\edef\beamerthemeInsiDark@dir{\currfiledir}
\AtBeginDocument{\graphicspath{{\beamerthemeInsiDark@dir assets/}}}

% ═══════════════════════════════════════════════════════════════════════════════
%  COLOR PALETTE
%
%  Theme palette is the colorbrewer "Paired" 12-color set.
%  Light / dark pairs: A/B (blue), C/D (green), E/F (red), G/H (orange),
%                      I/J (purple), K/L (yellow / brown).
%
%  Reserved neutrals:
%    InsiDark   #01091E  midnight navy    title / section / header bg
%    themeMid   #666666  mid-gray         footer / caption text
%    themeBg    #F4F4F4  light gray       neutral block body background
%
%  Title-slide only (do not use elsewhere in the deck):
%    nuGold     #FDBB45  yellow-gold      title-page subtitle accent
% ═══════════════════════════════════════════════════════════════════════════════
\definecolor{InsiDark}{HTML}{01091E}
\definecolor{themeMid}{HTML}{666666}
\definecolor{themeBg} {HTML}{F4F4F4}
\definecolor{nuGold}  {HTML}{FDBB45} % title slide only

% Paired-A .. Paired-L come from the colorbrewer pgfplots library loaded above.

% __ Beamer color roles ________________________________________________________
\setbeamercolor{normal text}  {fg=black, bg=white}
\setbeamercolor{alerted text} {fg=Paired-F}
\setbeamercolor{structure}    {fg=InsiDark}

% Title-page text: white for legibility on dark background
\setbeamercolor{title}    {fg=white}
\setbeamercolor{subtitle} {fg=nuGold}      % title slide only
\setbeamercolor{author}   {fg=white}
\setbeamercolor{institute}{fg=white!90}
\setbeamercolor{event}    {fg=white!80}
\setbeamercolor{date}     {fg=white!70}

% Frametitle: no bg fill — the background template draws the image behind it
\setbeamercolor{frametitle}{fg=white, bg=}

% Blocks (Paired: blue = info, red = alert, green = example)
\setbeamercolor{block title}         {fg=white,    bg=Paired-B}
\setbeamercolor{block body}          {fg=black,    bg=themeBg}
\setbeamercolor{block title alerted} {fg=white,    bg=Paired-F}
\setbeamercolor{block body  alerted} {fg=black,    bg=Paired-E!25}
\setbeamercolor{block title example} {fg=white,    bg=Paired-D}
\setbeamercolor{block body  example} {fg=black,    bg=Paired-C!25}

% Lists — plain black bullets
\setbeamercolor{itemize item}       {fg=black}
\setbeamercolor{itemize subitem}    {fg=black}
\setbeamercolor{itemize subsubitem} {fg=black}
\setbeamercolor{enumerate item}     {fg=black}
\setbeamercolor{enumerate subitem}  {fg=black}

\setbeamercolor{footline}{fg=themeMid, bg=white}

% __ Fonts _____________________________________________________________________
\setbeamerfont{title}      {size=\LARGE, series=\bfseries}
\setbeamerfont{subtitle}   {size=\small, series=\normalfont}
\setbeamerfont{author}     {size=\normalsize}
\setbeamerfont{institute}  {size=\footnotesize}
\setbeamerfont{event}      {size=\footnotesize}
\setbeamerfont{date}       {size=\footnotesize, shape=\itshape}
\setbeamerfont{frametitle} {size=\large, series=\bfseries}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{footline}   {size=\tiny}

% __ Navigation / headline _____________________________________________________
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}

\setbeamertemplate{itemize item}      {\raisebox{0.15ex}{\small\textbullet}}
\setbeamertemplate{itemize subitem}   {\raisebox{0.15ex}{\footnotesize--}}
\setbeamertemplate{itemize subsubitem}{\raisebox{0.15ex}{\scriptsize\textbullet}}

% __ Content-slide background: bg-dark image clipped to frametitle strip _______
% Rendered BEFORE frame content → sits behind frametitle text.
% Shows the BOTTOM of the image (the dense dot-wave region) in the header strip.
% Dark (plain) frames suppress this via \setbeamertemplate{background}{} in their group.
\newlength{\nuframeht}
\setlength{\nuframeht}{3.15em}
\newlength{\nubgshift}  % computed at begin-document when \paperheight is known

\AtBeginDocument{\setlength{\nubgshift}{\dimexpr\paperheight-\nuframeht\relax}}

\setbeamertemplate{background}{%
	\begin{tikzpicture}
		\useasboundingbox (0pt, 0pt) rectangle (\paperwidth, \paperheight);
		\begin{scope}
			\clip (0pt, \nubgshift) rectangle (\paperwidth, \paperheight);
			% anchor=south west → image bottom sits at the clip boundary;
			% the clip then reveals only the very bottom strip of the image.
			\node[anchor=south west, inner sep=0pt] at (0pt, \nubgshift) {%
				\includegraphics[width=\paperwidth, height=\paperheight]{assets/bg-dark}%
			};
		\end{scope}
	\end{tikzpicture}%
}

% __ Frametitle: transparent colorbox (image comes from background) _____________
\setbeamertemplate{frametitle}{%
	\nointerlineskip
	\begin{beamercolorbox}[wd=\paperwidth, leftskip=1.0em, rightskip=1.0em]{frametitle}%
		% vbox of fixed height with vfil → text is vertically centred
		\vbox to \nuframeht{%
			\vfil
			\usebeamerfont{frametitle}\insertframetitle
			\ifx\insertframesubtitle\empty\else
				{\hspace{0.5em}\small\normalfont\color{Paired-A}%
					\guillemotright\,\insertframesubtitle}%
			\fi
			\vfil
		}%
	\end{beamercolorbox}%
}

% __ Footline: page numbers only, no bar _______________________________________
\setbeamertemplate{footline}{%
	\begin{beamercolorbox}[wd=\paperwidth, rightskip=0.8em]{footline}%
		\vskip0.3em
		\hskip1.1em
		{\usebeamerfont{footline}\color{nuMid}%
		\insertshortauthor}%
		\hfill
		{\usebeamerfont{footline}\color{nuMid}%
			\insertframenumber\,/\,\inserttotalframenumber}%
		\vskip0.3em
	\end{beamercolorbox}%
}

% __ Full dark background (for background canvas on dark slides) _______________
% NOTE: named without @ so it can be called directly from .tex files.
\newcommand{\InsiDarkBg}{%
	\includegraphics[width=\paperwidth, height=\paperheight]{assets/bg-dark}%
}

% __ Logo: capital-N monogram, title + closing slides only ____________________
\newcommand{\nuLogos}{%
	\begin{tikzpicture}[remember picture, overlay]
		\node[anchor=north east, inner sep=0.02\paperwidth]
		at (current page.north east) {%
			\includegraphics[height=0.16\paperheight]{assets/logo-insi}%
		};
	\end{tikzpicture}%
}

% __ Event metadata (like \date / \institute but for conference name) __________
% Usage: \event{IEEE INFOCOM 2026 Workshop on 6G AI-RAN}
\newcommand{\event}[1]{\def\insertevent{#1}}
\def\insertevent{}

% __ Title page ________________________________________________________________
% Usage in main.tex:
%   \event{Conference Name}
%   { \setbeamertemplate{background canvas}{\InsiDarkBg}
%     \setbeamertemplate{footline}{}
%     \begin{frame}[plain]\titlepage\end{frame} }
\setbeamertemplate{title page}{%
	\nuLogos
	\vbox to \paperheight{%
		\vspace{0.15\paperheight}
		\begin{beamercolorbox}[leftskip=0.04\paperwidth, rightskip=0.2\paperwidth]{title}%
			\usebeamerfont{title}\inserttitle\par
			\ifx\insertsubtitle\empty\else
				\vskip0.9em
				{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}%
				\let\@stcr\\\def\\{\@stcr[-0.9em]}% this regulates the line spacing for the subtitle
				\insertsubtitle}\par
			\fi
		\end{beamercolorbox}
		\vfill
		\begin{beamercolorbox}[leftskip=0.04\paperwidth]{author}%
			\usebeamerfont{author}\insertauthor\par
			\ifx\insertinstitute\empty\else
				\vskip0.25em
				{\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute}\par
			\fi
			\ifx\insertevent\empty\else
				\vskip0.2em
				{\usebeamerfont{event}\usebeamercolor[fg]{event}\insertevent}\par
			\fi
			\vskip0.2em
			{\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}
		\end{beamercolorbox}
		\vspace{0.05\paperheight}
	}%
}

% __ Section page ______________________________________________________________
\newcommand{\sectionframe}{%
	{%
			\setbeamertemplate{background}{}%
			\setbeamertemplate{background canvas}{\InsiDarkBg}%
			\setbeamertemplate{footline}{}%
			\begin{frame}[plain]
				\vfill
				\begin{center}
					{\Large\bfseries\color{white}\insertsectionhead}
				\end{center}
				\vfill
			\end{frame}%
		}%
}

% __ Closing slide _____________________________________________________________
% Usage: \closingframe{Thank you}{your@email.edu}
\newcommand{\closingframe}[2]{%
	{%
			\setbeamertemplate{background}{}%
			\setbeamertemplate{background canvas}{\InsiDarkBg}%
			\setbeamertemplate{footline}{}%
			\begin{frame}[plain]
				\nuLogos
				\vfill
				\begin{center}
					{\Large\bfseries\color{white}#1}\\[0.9em]
					{\color{white!80}\small #2}
				\end{center}
				\vfill
			\end{frame}%
		}%
}
